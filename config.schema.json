{
  "pluginAlias": "LegrandMyHome",
  "pluginType": "platform",
  "headerDisplay": "Plugin Homebridge per BTicino MyHome OpenWebNet (WHO=18) con compatibilit\u00e0 Eve per potenza istantanea e consumo totale.",
  "footerDisplay": "Per i tipi di accessorio supportati e il significato dell'indirizzo, consulta il README del plugin.",
  "schema": {
    "type": "object",
    "properties": {
      "ipaddress": {
        "title": "Indirizzo IP gateway MyHome",
        "type": "string",
        "required": true,
        "description": "Indirizzo IP del gateway OpenWebNet (es. F454, MH202)"
      },
      "port": {
        "title": "Porta",
        "type": "integer",
        "required": true,
        "default": 20000
      },
      "ownpassword": {
        "title": "Password OWN",
        "type": "string",
        "required": true
      },
      "discovery": {
        "title": "Discovery",
        "type": "boolean",
        "default": false
      },
      "devices": {
        "title": "Dispositivi",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "accessory": {
              "title": "Tipo accessorio",
              "type": "string",
              "required": true,
              "oneOf": [
                {
                  "title": "Relay (luce/rel\u00e8 ON-OFF)",
                  "enum": [
                    "MHRelay"
                  ]
                },
                {
                  "title": "Presa (Outlet)",
                  "enum": [
                    "MHOutlet"
                  ]
                },
                {
                  "title": "Relay luce",
                  "enum": [
                    "MHRelayLight"
                  ]
                },
                {
                  "title": "Dimmer",
                  "enum": [
                    "MHDimmer"
                  ]
                },
                {
                  "title": "Tenda semplice (F411)",
                  "enum": [
                    "MHBlind"
                  ]
                },
                {
                  "title": "Tenda avanzata (F401)",
                  "enum": [
                    "MHBlindAdvanced"
                  ]
                },
                {
                  "title": "Termostato (F430)",
                  "enum": [
                    "MHThermostat"
                  ]
                },
                {
                  "title": "Termometro esterno",
                  "enum": [
                    "MHExternalThermometer"
                  ]
                },
                {
                  "title": "Sensore contatto (F428)",
                  "enum": [
                    "MHContactSensor"
                  ]
                },
                {
                  "title": "Misuratore potenza/consumo (WHO=18)",
                  "enum": [
                    "MHPowerMeter"
                  ]
                },
                {
                  "title": "Scenario",
                  "enum": [
                    "MHScene"
                  ]
                }
              ]
            },
            "name": {
              "title": "Nome",
              "type": "string",
              "required": true
            },
            "address": {
              "title": "Indirizzo",
              "type": "string",
              "required": true,
              "description": "Indirizzo OpenWebNet del dispositivo, es. 0/1/5 per luci/tende/prese, oppure numerico per termostati/sensori/power meter"
            },
            "scene": {
              "title": "Numero scenario",
              "type": "string",
              "description": "Solo per accessori di tipo Scenario"
            },
            "time": {
              "title": "Tempo di movimento (secondi)",
              "type": "integer",
              "description": "Solo per tende e alcuni misuratori"
            },
            "manufacturer": {
              "title": "Produttore (mostrato nell'app Home)",
              "type": "string",
              "description": "Solo per misuratori di potenza"
            },
            "model": {
              "title": "Modello (mostrato nell'app Home)",
              "type": "string",
              "description": "Solo per misuratori di potenza"
            },
            "matterDeviceType": {
              "title": "Tipo dispositivo Matter",
              "type": "string",
              "default": "outlet",
              "description": "Solo misuratori WHO=18. La presa \u00e8 una rappresentazione compatibile: non comanda il circuito. Il contatore nativo richiede una versione Homebridge che esponga ElectricalMeter (verificato beta.17+). Cambiare tipo pu\u00f2 cambiare la visualizzazione in Casa; non implica somma o esclusione dal totale.",
              "oneOf": [
                {
                  "title": "Presa virtuale con letture (compatibilit\u00e0 Casa)",
                  "enum": [
                    "outlet"
                  ]
                },
                {
                  "title": "Contatore nativo ElectricalMeter",
                  "enum": [
                    "electricalMeter"
                  ]
                }
              ]
            }
          }
        }
      },
      "matterDiagnostics": {
        "title": "Diagnostica letture Matter",
        "type": "boolean",
        "default": false,
        "description": "Registra i watt inviati dai misuratori MyHome per confrontare prima/dopo."
      }
    }
  }
}
